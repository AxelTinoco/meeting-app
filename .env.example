# --- Google service account (domain-wide delegation) ---
# Autoriza el Client ID de la SA en Admin Console con los scopes:
#   https://www.googleapis.com/auth/calendar.events
#   https://www.googleapis.com/auth/calendar.readonly
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# PEM PKCS#8. En una sola línea con \n escapados, o multilínea entre comillas.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_WORKSPACE_DOMAIN=gerundio.com.mx

# --- OAuth client (login del equipo) ---
# Client de tipo "web" en Google Cloud Console. Da de alta como "Authorized redirect URI":
#   http://localhost:3000/api/auth/callback   (dev)
#   https://<tu-dominio>/api/auth/callback    (prod)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Opcional: si se deja vacío, el callback se deriva del host de la petición.
GOOGLE_OAUTH_REDIRECT_URI=

# --- Sesión ---
# Cifra y firma la cookie de sesión. Mínimo 32 caracteres; distinto en dev y prod.
# Genéralo con: openssl rand -base64 48
SESSION_SECRET=

# --- Slack (avisos de juntas al canal) ---
# URL del trigger de un workflow de Workflow Builder ("Desde un webhook").
# El workflow declara DOS variables y su único paso las publica en el canal:
#   `text`     tipo Texto            -> el mensaje ya formateado
#   `id_user`  tipo Usuario de Slack -> a quién mencionar, insertado con la opción de
#                                        pantalla "@nombre de Slack"
# Ambas son OBLIGATORIAS: si `id_user` trae un correo que Slack no reconoce, el trigger
# contesta 400 y NO publica nada, ni el texto. Por eso el código reintenta con otra persona
# en vez de publicar sin mención — publicar sin mención no es posible en este workflow.
# Se usa webhook y no una app con bot token porque instalar apps en el workspace exige
# aprobación de un *owner* de Slack.
SLACK_WEBHOOK_URL=
# Es OPCIONAL: sin ella la app funciona igual, simplemente no avisa a Slack.
# Es un SECRETO: quien la tenga puede publicar en el canal.
#
# Una mención SOLO funciona por la variable tipada. Un `<@U123>` escrito dentro de la
# variable de texto sale literal: Workflow Builder lo escapa a propósito.

# Nota (Cloudflare Workers): en dev, copia estas vars a `.dev.vars`.
# En producción usa `wrangler secret put <NOMBRE>` (no las pongas en wrangler.jsonc).
# La app NO arranca sin credenciales: no hay modo demo.
