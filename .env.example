# --- Google service account (domain-wide delegation) ---
# Autoriza el Client ID de la SA en Admin Console con los scopes:
#   https://www.googleapis.com/auth/calendar.events
#   https://www.googleapis.com/auth/calendar.readonly
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# PEM PKCS#8. En una sola línea con \n escapados, o multilínea entre comillas.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_WORKSPACE_DOMAIN=gerundio.com.mx

# --- OAuth client (login del equipo) ---
# Client de tipo "web" en Google Cloud Console. Da de alta como "Authorized redirect URI":
#   http://localhost:3000/api/auth/callback   (dev)
#   https://<tu-dominio>/api/auth/callback    (prod)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Opcional: si se deja vacío, el callback se deriva del host de la petición.
GOOGLE_OAUTH_REDIRECT_URI=

# --- Sesión ---
# Cifra y firma la cookie de sesión. Mínimo 32 caracteres; distinto en dev y prod.
# Genéralo con: openssl rand -base64 48
SESSION_SECRET=

# Nota (Cloudflare Workers): en dev, copia estas vars a `.dev.vars`.
# En producción usa `wrangler secret put <NOMBRE>` (no las pongas en wrangler.jsonc).
# La app NO arranca sin credenciales: no hay modo demo.
